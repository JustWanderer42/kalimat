rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Google accounts allowed to open AND change the songbook. To give a choir member editing access,
    // add their Gmail address to this list and run: firebase deploy --only firestore:rules
    function allowed() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email.lower() in [
          'you@example.com'
        ];
    }

    // The shared choir code: anyone who enters it can READ songs and lists, but not change them.
    // It lives only here (never in the app's files). To change it, edit it below and run
    //   firebase deploy --only firestore:rules
    // Everyone who joined with the old code is locked out until they enter the new one.
    function choirCode() {
      return 'change-me';
    }
    function viewer() {
      return request.auth != null
        && exists(/databases/$(database)/documents/members/$(request.auth.uid))
        && get(/databases/$(database)/documents/members/$(request.auth.uid)).data.code == choirCode();
    }

    match /songs/{songId} {
      allow read: if allowed() || viewer();
      allow write: if allowed();
    }
    // Song lists (setlists): a name and the song ids in the order chosen.
    match /lists/{listId} {
      allow read: if allowed() || viewer();
      allow write: if allowed();
    }
    // One record per device that entered the choir code. It can only be written with the right code.
    match /members/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['code', 'joinedAt'])
        && request.resource.data.code == choirCode();
    }
  }
}
